# Copie para .env e preencha. A chave nunca vai para o git.
GROQ_API_KEY=gsk_...
# Fora do Docker o Postgres do compose fica exposto em 5433 (5432 costuma estar ocupado).
DATABASE_URL=postgresql://banking:banking@localhost:5433/banking
POSTGRES_USER=banking
POSTGRES_PASSWORD=banking
POSTGRES_DB=banking
# Opcionais (defaults em src/banking_ai/config.py):
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=qwen/qwen3.6-27b
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# GROQ_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
# DEMO_USER_PIX_KEY=daniel@email.com
# INJECTION_THRESHOLD=0.5
